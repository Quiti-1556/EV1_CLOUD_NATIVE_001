{
  "info": {
    "name": "EP1 API Gateway, JWT y roles",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "api_url",
      "value": "https://REEMPLAZAR.execute-api.us-east-1.amazonaws.com"
    },
    {
      "key": "token_solicitante",
      "value": ""
    },
    {
      "key": "token_aprobador",
      "value": ""
    },
    {
      "key": "solicitud_id",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "01 Sin JWT — 401",
      "request": {
        "method": "GET",
        "url": "{{api_url}}/datos",
        "auth": {
          "type": "noauth"
        },
        "header": []
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 401\", () => pm.response.to.have.status(401));"
            ]
          }
        }
      ]
    },
    {
      "name": "02 Solicitante — 200",
      "request": {
        "method": "GET",
        "url": "{{api_url}}/datos",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{token_solicitante}}",
              "type": "string"
            }
          ]
        },
        "header": []
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "03 Crear — 201",
      "request": {
        "method": "POST",
        "url": "{{api_url}}/solicitudes",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{token_solicitante}}",
              "type": "string"
            }
          ]
        },
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"tipo\": \"OTRO\",\n  \"titulo\": \"EP1 Evidencia Gateway\",\n  \"descripcion\": \"Registro creado mediante API Gateway\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
              "pm.collectionVariables.set(\"solicitud_id\", pm.response.json().id);"
            ]
          }
        }
      ]
    },
    {
      "name": "04 Consultar — 200",
      "request": {
        "method": "GET",
        "url": "{{api_url}}/solicitudes/{{solicitud_id}}",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{token_solicitante}}",
              "type": "string"
            }
          ]
        },
        "header": []
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "05 Pendientes solicitante — 403",
      "request": {
        "method": "GET",
        "url": "{{api_url}}/solicitudes/pendientes",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{token_solicitante}}",
              "type": "string"
            }
          ]
        },
        "header": []
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 403\", () => pm.response.to.have.status(403));"
            ]
          }
        }
      ]
    },
    {
      "name": "06 Decidir solicitante — 403",
      "request": {
        "method": "POST",
        "url": "{{api_url}}/solicitudes/{{solicitud_id}}/decision",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{token_solicitante}}",
              "type": "string"
            }
          ]
        },
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"decision\": \"APROBAR\",\n  \"comentario\": \"Intento sin permisos\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 403\", () => pm.response.to.have.status(403));"
            ]
          }
        }
      ]
    },
    {
      "name": "07 Pendientes aprobador — 200",
      "request": {
        "method": "GET",
        "url": "{{api_url}}/solicitudes/pendientes",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{token_aprobador}}",
              "type": "string"
            }
          ]
        },
        "header": []
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "08 Decidir aprobador — 200",
      "request": {
        "method": "POST",
        "url": "{{api_url}}/solicitudes/{{solicitud_id}}/decision",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{token_aprobador}}",
              "type": "string"
            }
          ]
        },
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"decision\": \"APROBAR\",\n  \"comentario\": \"Validado en evaluación\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    }
  ]
}
